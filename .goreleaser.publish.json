{
  "version": 2,
  "project_name": "agentd",
  "builds": [{"skip": true}],
  "snapshot": {"version_template": "{{ .Env.AGENTD_PACKAGE_VERSION }}"},
  "checksum": {
    "name_template": "SHA256SUMS",
    "algorithm": "sha256",
    "extra_files": [
      {"glob": "{{ .Env.AGENTD_RELEASE_DIR }}/agentd-*"},
      {"glob": "{{ .Env.AGENTD_RELEASE_DIR }}/BUILDINFO.json"}
    ]
  },
  "release": {
    "github": {"owner": "Bit-Precise", "name": "agentd"},
    "prerelease": "auto",
    "extra_files": [
      {"glob": "{{ .Env.AGENTD_RELEASE_DIR }}/agentd-*"},
      {"glob": "{{ .Env.AGENTD_RELEASE_DIR }}/BUILDINFO.json"}
    ]
  }
}
